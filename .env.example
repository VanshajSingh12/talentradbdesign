# Talentra DB - local Postgres (Docker)
# Copy to .env and fill in passwords before running docker compose up

POSTGRES_USER=talentradb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=talentra

# Optional app-side DSN (used by Python seed scripts)
PG_DSN=dbname=talentra user=talentradb password=changeme host=localhost port=5431
